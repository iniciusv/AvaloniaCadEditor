<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AvaloniaCadEditor.Application\AvaloniaCadEditor.Application.csproj" />
    <ProjectReference Include="..\AvaloniaCadEditor.Domain\AvaloniaCadEditor.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Occt.NET" Version="7.9.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(NuGetPackageRoot)occt.net\7.9.0\build\occt\x64\**\*.*">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
    <None Include="$(NuGetPackageRoot)occt.net\7.9.0\lib\net8.0-windows7.0\x64\Occt.NET.dll">
      <Link>Occt.NET.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
    <None Include="$(NuGetPackageRoot)occt.net\7.9.0\lib\net8.0-windows7.0\x64\Ijwhost.dll">
      <Link>Ijwhost.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
