<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cena do AvaloniaCad. Compila sozinha com `dotnet build`; o app lê só este arquivo
       por convenção (todos os *.cs da pasta, exceto bin/, obj/ e .cad/). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AvaloniaCadDir Condition="'$(AvaloniaCadDir)' == ''">C:\Users\vinic\source\repos\AvaloniaCadEditor\AvaloniaCadEditor.UI\bin\Debug\net10.0-windows\</AvaloniaCadDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AvaloniaCadEditor.Domain">
      <HintPath>$(AvaloniaCadDir)AvaloniaCadEditor.Domain.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Linq" />
    <Using Include="AvaloniaCadEditor.Domain.Features" />
    <Using Include="AvaloniaCadEditor.Domain.ValueObjects" />
    <Using Include="AvaloniaCadEditor.Domain.Profiles" />
    <Using Include="AvaloniaCadEditor.Domain.Scripting.Scene" Static="true" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove=".cad/**" />
  </ItemGroup>
</Project>
