<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:drafting="clr-namespace:AvaloniaCadEditor.UI.Drafting"
             x:Class="AvaloniaCadEditor.UI.Drafting.DraftingLegend"
             x:DataType="drafting:DraftingViewModel"
             IsVisible="{Binding ShowLegend}">

    <!-- Legenda das cotas, flutuando no canto da viewport como a legenda de um mapa. Tem fundo,
         então os cliques nela não passam para a cena. -->
    <Border Background="#D91E1E1E" BorderBrush="#555" BorderThickness="1" CornerRadius="6" Padding="10,8">
        <StackPanel Spacing="6" MinWidth="190">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Copiar tudo" FontSize="10" Padding="6,1" MinHeight="0"
                        ToolTip.Tip="Copia como texto tudo que está desenhado nesta vista: sólidos, cadeias de cota por nível, ocultas, linhas de centro. Alt+clique num texto de cota copia só a cadeia dela."
                        Click="CopyAll_Click"/>
                <TextBlock Text="Cotas" FontWeight="SemiBold" Foreground="#DDD" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{Binding SuppressedText}" Foreground="Orange" FontSize="11" FontStyle="Italic"
                       IsVisible="{Binding HasSuppressed}"/>
            <ItemsControl ItemsSource="{Binding Levels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="drafting:LevelSummary">
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Title}" Foreground="#8CD7FF" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Counts}" Foreground="#AAA" FontSize="10" VerticalAlignment="Center"/>
                                <CheckBox Content="mostrar ocultas" FontSize="10" Foreground="#CCC" MinHeight="0" Padding="2,0"
                                          IsChecked="{Binding ForceShow}" IsEnabled="{Binding CanForce}"
                                          IsVisible="{Binding CanForce}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Cota selecionada (clique no texto dela): o que mede e como mudá-la pelo código. -->
            <StackPanel DataContext="{Binding Levers}" x:DataType="drafting:DimensionLeversViewModel"
                        IsVisible="{Binding HasSelection}" Spacing="4" MaxWidth="340">
                <Border Height="1" Background="#555" Margin="0,4"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" FontSize="10" Padding="5,0" MinHeight="0"
                            ToolTip.Tip="Tirar a seleção (Esc)" Command="{Binding ClearCommand}"/>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#FFB347" FontSize="12" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="{Binding MeasuredText}" Foreground="#40FFF2" FontSize="10" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Status}" Foreground="#AAA" FontSize="10" FontStyle="Italic" TextWrapping="Wrap"/>

                <ListBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                         Background="Transparent" MaxHeight="260" Padding="0"
                         IsVisible="{Binding HasOptions}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="drafting:LeverOptionItem">
                            <StackPanel Spacing="1" ToolTip.Tip="{Binding Where}">
                                <TextBlock Text="{Binding Title}" Foreground="#EEE" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Companions}" Foreground="#DDD" FontSize="10" TextWrapping="Wrap"
                                           IsVisible="{Binding HasCompanions}"/>
                                <TextBlock Text="{Binding Effect}" Foreground="#FF7AD9" FontSize="10" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Keeps}" Foreground="#7CDB7C" FontSize="10" TextWrapping="Wrap"
                                           IsVisible="{Binding HasKeeps}"/>
                                <TextBlock Text="{Binding Breaks}" Foreground="Orange" FontSize="10" TextWrapping="Wrap"
                                           IsVisible="{Binding HasBreaks}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasOptions}">
                    <TextBlock Text="Valor novo" Foreground="#CCC" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding TargetText}" Width="80" FontSize="11" MinHeight="0" Padding="4,1">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding ApplyCommand}"/>
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Content="Aplicar" FontSize="11" Padding="8,1" MinHeight="0" Command="{Binding ApplyCommand}"
                            ToolTip.Tip="Calcula os números da opção escolhida, confere numa execução e grava no código (Ctrl+Z desfaz)."/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
