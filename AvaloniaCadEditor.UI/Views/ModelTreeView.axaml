<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AvaloniaCadEditor.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
             x:Class="AvaloniaCadEditor.UI.Views.ModelTreeView"
             x:DataType="vm:ModelTreeViewModel">

    <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="6">
        <Grid RowDefinitions="Auto, *">
            <!-- Header -->
            <Border Grid.Row="0" Background="#282828" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                <Grid ColumnDefinitions="Auto, *">
                    <TextBlock Grid.Column="0" Text="🌲 Árvore do Modelo" FontWeight="Bold" Foreground="#DDDDDD" FontSize="13" />
                </Grid>
            </Border>

            <!-- Tree View -->
            <TreeView Grid.Row="1"
                      ItemsSource="{Binding RootNodes}"
                      SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                      Background="Transparent">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:TreeItemNode">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="2">
                            <TextBlock Text="{Binding Icon}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.Styles>
                    <Style Selector="TreeViewItem" x:DataType="vm:TreeItemNode">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="Padding" Value="4,2" />
                    </Style>
                    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
                        <Setter Property="Background" Value="#007ACC" />
                    </Style>
                </TreeView.Styles>
            </TreeView>
        </Grid>
    </Border>
</UserControl>
