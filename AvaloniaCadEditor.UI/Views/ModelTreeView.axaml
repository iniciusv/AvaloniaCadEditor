<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AvaloniaCadEditor.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="300"
             x:Class="AvaloniaCadEditor.UI.Views.ModelTreeView"
             x:DataType="vm:ModelTreeViewModel">

    <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="6">
        <Grid RowDefinitions="Auto, *">
            <!-- Header -->
            <Border Grid.Row="0" Background="#282828" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                <Grid ColumnDefinitions="Auto, *">
                    <TextBlock Grid.Column="0" Text="🌲 Árvore do Modelo" FontWeight="Bold" Foreground="#DDDDDD" FontSize="13" />
                </Grid>
            </Border>

            <!-- Tree View -->
            <TreeView Grid.Row="1"
                      ItemsSource="{Binding RootNodes}"
                      Background="Transparent"
                      DragDrop.AllowDrop="True"
                      DragDrop.DragOver="OnDragOver"
                      DragDrop.Drop="OnDrop">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:TreeItemNode">
                        <Border Classes.selectedNode="{Binding IsSelected}" CornerRadius="3" Padding="6,3" Margin="1">
                            <Grid ColumnDefinitions="Auto, Auto, *">
                                <!-- Eye Toggle for Visibility -->
                                <ToggleButton Grid.Column="0" 
                                              IsChecked="{Binding IsVisible, Mode=TwoWay}" 
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="0" Margin="0,0,4,0"
                                              Width="24" Height="24"
                                              Cursor="Hand"
                                              ToolTip.Tip="Toggle Visibility">
                                    <Panel>
                                        <Path Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17C9.24,17 7,14.76 7,12C7,9.24 9.24,7 12,7C14.76,7 17,9.24 17,12C17,14.76 14.76,17 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"
                                              Fill="#BBBBBB" Stretch="Uniform" Width="14" Height="14"
                                              IsVisible="{Binding IsVisible}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <Path Data="M11.83,9L15,12.16C15,12.11 15,12.05 15,12A3,3 0 0,0 12,9C11.94,9 11.89,9 11.83,9M7.53,9.8L9.08,11.35C9.03,11.56 9,11.77 9,12A3,3 0 0,0 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17C9.24,17 7,14.76 7,12C7,11.21 7.2,10.47 7.53,9.8M2,4.27L4.28,6.55L4.73,7C3.08,8.3 1.78,10 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.08L19.73,22L21,20.73L3.27,3L2,4.27M7.53,9.8L22.53,24.8L23.8,23.53L18.4,18.13C19.95,16.82 21.68,14.65 23,12C21.27,7.61 17,4.5 12,4.5C10.6,4.5 9.26,4.75 8,5.2L7.53,9.8Z"
                                              Fill="#555555" Stretch="Uniform" Width="14" Height="14"
                                              IsVisible="{Binding !IsVisible}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Panel>
                                </ToggleButton>

                                <Path Grid.Column="1" Data="{Binding Icon}" Fill="#999999" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12" Foreground="#DDDDDD" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.Styles>
                    <Style Selector="TreeViewItem" x:DataType="vm:TreeItemNode">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="Padding" Value="2,1" />
                    </Style>
                    <Style Selector="Border.selectedNode">
                        <Setter Property="Background" Value="#007ACC" />
                    </Style>
                    <Style Selector="Border.selectedNode TextBlock">
                        <Setter Property="Foreground" Value="#FFFFFF" />
                        <Setter Property="FontWeight" Value="Bold" />
                    </Style>
                    <Style Selector="Border:not(.selectedNode) TextBlock">
                        <Setter Property="Foreground" Value="#CCCCCC" />
                    </Style>
                </TreeView.Styles>
            </TreeView>
        </Grid>
    </Border>
</UserControl>
