<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AvaloniaCadEditor.UI.Controls"
        xmlns:views="clr-namespace:AvaloniaCadEditor.UI.Views"
        xmlns:vm="clr-namespace:AvaloniaCadEditor.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="AvaloniaCadEditor.Views.MainWindow"
        x:DataType="vm:CadViewModel"
        Title="Avalonia CAD Editor - 3D Parametric"
        Background="#1A1A1A">

    <Grid RowDefinitions="Auto,*,30">
        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#2D2D2D" Margin="4" Spacing="6">
            <Button Content="Select (Space)" Command="{Binding SelectSelectToolCommand}" />
            <Button Content="Line (L)" Command="{Binding SelectLineToolCommand}" />
            <Button Content="Circle (C)" Command="{Binding SelectCircleToolCommand}" />
            <Button Content="Trim (T)" Command="{Binding SelectTrimToolCommand}" />
            <Button Content="Extrude (P)" Command="{Binding SelectExtrudeToolCommand}" Background="#007ACC" Foreground="White" FontWeight="Bold" />
            <Button Content="Cut (-)" Command="{Binding SelectBooleanCutCommand}" Background="#E67E22" Foreground="White" FontWeight="Bold" />
            <Button Content="Fuse (+)" Command="{Binding SelectBooleanFuseCommand}" Background="#27AE60" Foreground="White" FontWeight="Bold" />
            <Button Content="WorkPlane (W)" Command="{Binding SelectSetWorkPlaneCommand}" Background="#8E44AD" Foreground="White" FontWeight="Bold" />
            <Button Content="Delete (Del)" Command="{Binding DeleteSelectedCommand}" Background="#A83232" Foreground="White" />

            <Separator Width="1" Height="20" Background="#555" Margin="4,0" />
            <StackPanel Orientation="Horizontal" Spacing="2">
                <CheckBox IsChecked="{Binding OsnapEnabled}" Content="OSnap" Foreground="White" VerticalAlignment="Center"/>
                <Button Content="[⚙]" Background="Transparent" Foreground="LightGray" Padding="2" VerticalAlignment="Center">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="10" Width="260" Margin="5">
                                <TextBlock Text="OSnap Settings" FontWeight="Bold" Margin="0,0,0,5"/>
                                
                                <CheckBox IsChecked="{Binding OsnapSettings.EndpointEnabled}" Content="Endpoint" />
                                <CheckBox IsChecked="{Binding OsnapSettings.MidpointEnabled}" Content="Midpoint" />
                                <CheckBox IsChecked="{Binding OsnapSettings.CenterEnabled}" Content="Center" />
                                <CheckBox IsChecked="{Binding OsnapSettings.TangentEnabled}" Content="Tangent" />
                                
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="Tolerance:" VerticalAlignment="Center" Width="80"/>
                                    <NumericUpDown Value="{Binding OsnapSettings.SnapTolerance}" Minimum="1" Maximum="100" Increment="1" Width="140"/>
                                </StackPanel>

                                <Separator Background="#444" Height="1" Margin="0,5"/>
                                
                                <CheckBox IsChecked="{Binding OsnapSettings.GridSnapEnabled}" Content="Distance Snap" />
                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="20,0,0,0">
                                    <TextBlock Text="Increment:" VerticalAlignment="Center" Width="80"/>
                                    <NumericUpDown Value="{Binding OsnapSettings.GridIncrement}" Minimum="0.1" Increment="0.1" Width="140"/>
                                </StackPanel>

                                <CheckBox IsChecked="{Binding OsnapSettings.PolarSnapEnabled}" Content="Polar Angle Snap" />
                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="20,0,0,0">
                                    <TextBlock Text="Angle (º):" VerticalAlignment="Center" Width="80"/>
                                    <NumericUpDown Value="{Binding OsnapSettings.PolarAngleIncrement}" Minimum="1" Maximum="360" Increment="5" Width="140"/>
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <CheckBox IsChecked="{Binding ShowInternalEdges}" Content="Arestas Ocultas" Foreground="White" VerticalAlignment="Center"/>
        </StackPanel>
        
        <!-- Main Work Area (Viewport + Flexible Right Sidebar) -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 4, 320">
            
            <!-- Left/Center: Viewport -->
            <Panel Grid.Column="0" Background="Transparent"
                   PointerPressed="Viewport_PointerPressed"
                   PointerMoved="Viewport_PointerMoved"
                   PointerReleased="Viewport_PointerReleased"
                   PointerWheelChanged="Viewport_PointerWheelChanged">
                <controls:SilkViewportControl x:Name="ViewportControl" DataContext="{Binding}" />
            </Panel>

            <!-- Vertical Resizer / Splitter -->
            <GridSplitter Grid.Column="1" Width="4" Background="#141414" ResizeDirection="Columns" />

            <!-- Right Sidebar: Model Tree + Property Inspector -->
            <Grid Grid.Column="2" RowDefinitions="*, 4, 1.2*" Background="#1E1E1E">
                <!-- Top Section: Model Entity Tree & C# Code -->
                <TabControl Grid.Row="0" Margin="0" Padding="0">
                    <TabItem Header="Árvore" Padding="10,5">
                        <views:ModelTreeView DataContext="{Binding ModelTree}" />
                    </TabItem>
                    <TabItem Header="Código C#" Padding="10,5">
                        <Grid RowDefinitions="Auto,*">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="4" HorizontalAlignment="Right">
                                <Button Content="Atualizar Código" Command="{Binding GenerateCodeCommand}" />
                                <Button Content="▶ Run" Command="{Binding RunCodeCommand}"
                                        Background="#27AE60" Foreground="White" FontWeight="Bold" />
                            </StackPanel>
                            <TextBox Grid.Row="1" Text="{Binding GeneratedCSharpCode, Mode=TwoWay}" 
                                     IsReadOnly="False" 
                                     FontFamily="Consolas, Fira Code, Monospace" 
                                     Background="#1E1E1E" 
                                     Foreground="#D4D4D4"
                                     TextWrapping="NoWrap"
                                     AcceptsReturn="True"
                                     BorderThickness="0"
                                     Margin="2"/>
                        </Grid>
                    </TabItem>
                </TabControl>

                <!-- Horizontal Resizer / Splitter inside Sidebar -->
                <GridSplitter Grid.Row="1" Height="4" Background="#141414" ResizeDirection="Rows" />

                <!-- Bottom Section: Parametric Property Inspector -->
                <views:PropertyInspectorView Grid.Row="2" DataContext="{Binding PropertyInspector}" />
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#007ACC" Padding="6,3">
            <Grid ColumnDefinitions="*, Auto, Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="White" VerticalAlignment="Center" FontSize="12" />
                
                <TextBlock Grid.Column="1" Text="Measurement: " Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="12" />
                <Border Grid.Column="2" Background="White" CornerRadius="2" Padding="6,2" MinWidth="100">
                    <TextBlock Text="{Binding VcbText}" Foreground="Black" TextAlignment="Right" FontWeight="Bold" FontSize="12" />
                </Border>
            </Grid>
        </Border>
    </Grid>

</Window>
