<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AvaloniaCadEditor.UI.Controls"
        xmlns:refguides="clr-namespace:AvaloniaCadEditor.UI.ReferenceGuides"
        xmlns:drafting="clr-namespace:AvaloniaCadEditor.UI.Drafting"
        xmlns:views="clr-namespace:AvaloniaCadEditor.UI.Views"
        xmlns:vm="clr-namespace:AvaloniaCadEditor.UI.ViewModels"
        xmlns:res="clr-namespace:AvaloniaCadEditor.UI.Resources"
        xmlns:AvaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="AvaloniaCadEditor.Views.MainWindow"
        x:DataType="vm:CadViewModel"
        Title="{x:Static res:Strings.AppTitle}"
        Background="#1A1A1A">

    <Grid RowDefinitions="Auto,*,30">
        <!-- Toolbar: standard views (center) + view settings (right) -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,*" Background="#2D2D2D" Margin="4">
        <Grid.Styles>
            <Style Selector="Button.viewBtn, ToggleButton.viewBtn">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="LightGray"/>
                <Setter Property="Padding" Value="10,3"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="44"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </Grid.Styles>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Classes="viewBtn" Content="{x:Static res:Strings.ViewTop}" Tag="Top" Click="StandardView_Click"/>
            <Button Classes="viewBtn" Content="{x:Static res:Strings.ViewFront}" Tag="Front" Click="StandardView_Click"/>
            <Button Classes="viewBtn" Content="{x:Static res:Strings.ViewRight}" Tag="Right" Click="StandardView_Click"/>
            <Button Classes="viewBtn" Content="{x:Static res:Strings.ViewLeft}" Tag="Left" Click="StandardView_Click"/>
            <Button Classes="viewBtn" Content="{x:Static res:Strings.ViewBack}" Tag="Back" Click="StandardView_Click"/>
            <Button Classes="viewBtn" Content="{x:Static res:Strings.ViewBottom}" Tag="Bottom" Click="StandardView_Click"/>
            <Button Classes="viewBtn" Content="{x:Static res:Strings.ViewIso}" Tag="Isometric" Click="StandardView_Click"/>
            <Border Width="1" Background="#555" Margin="6,4"/>
            <ToggleButton Classes="viewBtn" Content="{x:Static res:Strings.ProjectionOrtho}"
                          ToolTip.Tip="{x:Static res:Strings.ProjectionOrthoTip}" Click="Projection_Click"/>
            <ToggleButton Classes="viewBtn" Content="{x:Static res:Strings.DisplayWireframe}"
                          ToolTip.Tip="{x:Static res:Strings.DisplayWireframeTip}" IsChecked="{Binding IsWireframe}"/>
            <Border Width="1" Background="#555" Margin="6,4"/>
            <ToggleButton Classes="viewBtn" Content="{x:Static res:Strings.DraftingDims}"
                          ToolTip.Tip="{x:Static res:Strings.DraftingDimsTip}" IsChecked="{Binding Drafting.IsVisible}"/>
            <ToggleButton Classes="viewBtn" Content="{x:Static res:Strings.DraftingPick}"
                          ToolTip.Tip="{x:Static res:Strings.DraftingPickTip}" IsChecked="{Binding Drafting.IsPicking}"
                          IsVisible="{Binding Drafting.IsVisible}"/>
            <Button Classes="viewBtn" Content="{x:Static res:Strings.DraftingReset}"
                    ToolTip.Tip="{x:Static res:Strings.DraftingResetTip}" Command="{Binding Drafting.RestoreCommand}"
                    IsVisible="{Binding Drafting.IsPicking}"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="15" HorizontalAlignment="Right" Margin="0,0,6,0">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <CheckBox IsChecked="{Binding OsnapEnabled}" Content="{x:Static res:Strings.Osnap}" Foreground="White" VerticalAlignment="Center"/>
                <Button Content="[⚙]" Background="Transparent" Foreground="LightGray" Padding="2" VerticalAlignment="Center">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="10" Width="260" Margin="5">
                                <TextBlock Text="{x:Static res:Strings.OsnapSettings}" FontWeight="Bold" Margin="0,0,0,5"/>
                                
                                <CheckBox IsChecked="{Binding OsnapSettings.EndpointEnabled}" Content="{x:Static res:Strings.Endpoint}" />
                                <CheckBox IsChecked="{Binding OsnapSettings.MidpointEnabled}" Content="{x:Static res:Strings.Midpoint}" />
                                <CheckBox IsChecked="{Binding OsnapSettings.CenterEnabled}" Content="{x:Static res:Strings.Center}" />
                                <CheckBox IsChecked="{Binding OsnapSettings.TangentEnabled}" Content="{x:Static res:Strings.Tangent}" />
                                
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{x:Static res:Strings.Tolerance}" VerticalAlignment="Center" Width="80"/>
                                    <NumericUpDown Value="{Binding OsnapSettings.SnapTolerance}" Minimum="1" Maximum="100" Increment="1" Width="140"/>
                                </StackPanel>

                                <Separator Background="#444" Height="1" Margin="0,5"/>
                                
                                <CheckBox IsChecked="{Binding OsnapSettings.GridSnapEnabled}" Content="{x:Static res:Strings.DistanceSnap}" />
                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="20,0,0,0">
                                    <TextBlock Text="{x:Static res:Strings.Increment}" VerticalAlignment="Center" Width="80"/>
                                    <NumericUpDown Value="{Binding OsnapSettings.GridIncrement}" Minimum="0.1" Increment="0.1" Width="140"/>
                                </StackPanel>

                                <CheckBox IsChecked="{Binding OsnapSettings.PolarSnapEnabled}" Content="{x:Static res:Strings.PolarAngleSnap}" />
                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="20,0,0,0">
                                    <TextBlock Text="{x:Static res:Strings.Angle}" VerticalAlignment="Center" Width="80"/>
                                    <NumericUpDown Value="{Binding OsnapSettings.PolarAngleIncrement}" Minimum="1" Maximum="360" Increment="5" Width="140"/>
                                </StackPanel>

                                <Separator Background="#444" Height="1" Margin="0,5"/>
                                <TextBlock Text="{x:Static res:Strings.ViewSettings}" FontWeight="Bold" Margin="0,0,0,5"/>
                                <CheckBox IsChecked="{Binding OsnapSettings.ColorFacesByNormal}" Content="{x:Static res:Strings.FaceColorByNormal}" />
                                <CheckBox IsChecked="{Binding OsnapSettings.ColorEdgesByAxis}" Content="{x:Static res:Strings.EdgeColorByAxis}" />
                                
                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,5,0,0">
                                    <TextBlock Text="Circle Segments:" VerticalAlignment="Center" Width="100"/>
                                    <NumericUpDown Value="{Binding ProfileSegments}" Minimum="3" Maximum="360" Increment="1" Width="120"/>
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <CheckBox IsChecked="{Binding ShowInternalEdges}" Content="{x:Static res:Strings.HiddenEdges}" Foreground="White" VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <CheckBox IsChecked="{Binding ReferenceGuides.IsVisible}" Content="{x:Static res:Strings.ReferenceGuides}" Foreground="White" VerticalAlignment="Center"/>
                <Button Content="{x:Static res:Strings.AnalyzeGuides}" Command="{Binding ReferenceGuides.AnalyzeCommand}"
                        IsVisible="{Binding ReferenceGuides.IsVisible}" Padding="6,2" VerticalAlignment="Center"/>
                <Button Content="{x:Static res:Strings.CopyGuides}" ToolTip.Tip="{x:Static res:Strings.CopyGuidesTip}" Click="CopyGuides_Click"
                        IsVisible="{Binding ReferenceGuides.IsVisible}" Padding="6,2" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Static res:Strings.GuidesAnalyzing}" Foreground="LightGray" VerticalAlignment="Center" FontStyle="Italic"
                           IsVisible="{Binding ReferenceGuides.IsAnalyzing}"/>
                <TextBlock Text="{x:Static res:Strings.GuidesStale}" Foreground="Orange" VerticalAlignment="Center" FontStyle="Italic"
                           IsVisible="{Binding ReferenceGuides.IsStale}"/>
            </StackPanel>
        </StackPanel>
        </Grid>

        <!-- Main Work Area (Left Sidebar + Viewport + Right Sidebar) -->
        <Grid Grid.Row="1" x:Name="MainWorkGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar: Draw & Modify Tools -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="6" Background="#252526">
                <StackPanel Width="160" Margin="0" Spacing="6">
                    <TextBlock Text="{x:Static res:Strings.Selection}" Foreground="LightGray" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <RadioButton GroupName="SelMode" IsChecked="{Binding IsFeatureSelectionMode}" Foreground="White"
                                     ToolTip.Tip="{x:Static res:Strings.Volumes}">
                            <Path Data="M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5M12,4.15L5,8.09L12,12.03L19,8.09L12,4.15M4.5,15.97L11.25,19.79V13.16L4.5,9.33V15.97M19.5,15.97V9.33L12.75,13.16V19.79L19.5,15.97Z"
                                  Fill="LightGray" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                        </RadioButton>
                        <RadioButton GroupName="SelMode" IsChecked="{Binding IsFaceSelectionMode}" Foreground="White"
                                     ToolTip.Tip="{x:Static res:Strings.Faces}">
                            <Path Data="M12,4.15 L5,8.09 L12,12.03 L19,8.09 Z"
                                  Stroke="LightGray" StrokeThickness="2" Fill="Transparent" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                        </RadioButton>
                        <RadioButton GroupName="SelMode" IsChecked="{Binding IsEdgeSelectionMode}" Foreground="White"
                                     ToolTip.Tip="{x:Static res:Strings.Edges}">
                            <Path Data="M4,20 L20,4"
                                  Stroke="LightGray" StrokeThickness="2" Fill="Transparent" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                        </RadioButton>
                    </StackPanel>

                    <Separator Height="1" Background="#555" Margin="0,4" />

                    <Button Content="{x:Static res:Strings.SelectTool}" Command="{Binding SelectSelectToolCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="{x:Static res:Strings.LineTool}" Command="{Binding SelectLineToolCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="{x:Static res:Strings.CircleTool}" Command="{Binding SelectCircleToolCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="{x:Static res:Strings.PolygonTool}" Command="{Binding SelectPolygonToolCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="{x:Static res:Strings.TrimTool}" Command="{Binding SelectTrimToolCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="{x:Static res:Strings.ExtendTool}" Command="{Binding SelectExtendToolCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="{x:Static res:Strings.OffsetTool}" Command="{Binding SelectOffsetToolCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="{x:Static res:Strings.MoveTool}" Command="{Binding SelectMoveToolCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="{x:Static res:Strings.RotateTool}" Command="{Binding SelectRotateToolCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                    <Button Content="{x:Static res:Strings.ExitSketch}" Command="{Binding ExitWorkPlaneCommand}" IsVisible="{Binding IsInCustomWorkPlane}" Background="#E74C3C" Foreground="White" FontWeight="Bold" Margin="0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    
                    <Separator Height="1" Background="#555" Margin="0,4" />

                    <Button Content="{x:Static res:Strings.ExtrudeTool}" Command="{Binding SelectExtrudeToolCommand}" Background="#007ACC" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="{x:Static res:Strings.SweepTool}" Command="{Binding SelectSweepToolCommand}" ToolTip.Tip="{x:Static res:Strings.SweepToolTooltip}" Background="#007ACC" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="{x:Static res:Strings.CutTool}" Command="{Binding SelectBooleanCutCommand}" Background="#E67E22" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="{x:Static res:Strings.FuseTool}" Command="{Binding SelectBooleanFuseCommand}" Background="#27AE60" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    <Button Content="Fillet/Bevel" Background="#16A085" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Fillet" Command="{Binding SelectFilletToolCommand}" CommandParameter="Fillet"/>
                                <MenuItem Header="Bevel (Chamfer)" Command="{Binding SelectFilletToolCommand}" CommandParameter="Bevel"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="{x:Static res:Strings.WorkPlaneTool}" Command="{Binding SelectSetWorkPlaneCommand}" Background="#8E44AD" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                    <!-- Planos de origem: os três planos que existem sem precisar de uma face para clicar -->
                    <TextBlock Text="{x:Static res:Strings.OriginPlanes}" Foreground="LightGray" FontSize="11" Margin="0,2,0,0"
                               ToolTip.Tip="{x:Static res:Strings.OriginPlanesTooltip}"/>
                    <Grid ColumnDefinitions="*,*,*" ToolTip.Tip="{x:Static res:Strings.OriginPlanesTooltip}">
                        <Button Grid.Column="0" Content="{x:Static res:Strings.PlaneXY}" Command="{Binding SelectOriginWorkPlaneCommand}" CommandParameter="XY"
                                Background="#6C3483" Foreground="White" FontWeight="Bold" Margin="0,0,2,0" Padding="0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="{x:Static res:Strings.PlaneXZ}" Command="{Binding SelectOriginWorkPlaneCommand}" CommandParameter="XZ"
                                Background="#6C3483" Foreground="White" FontWeight="Bold" Margin="2,0" Padding="0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        <Button Grid.Column="2" Content="{x:Static res:Strings.PlaneYZ}" Command="{Binding SelectOriginWorkPlaneCommand}" CommandParameter="YZ"
                                Background="#6C3483" Foreground="White" FontWeight="Bold" Margin="2,0,0,0" Padding="0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding ActiveWorkPlaneLabel}" Foreground="#9B9B9B" FontSize="11" TextWrapping="Wrap"/>
                    <Button Content="{x:Static res:Strings.DeleteTool}" Command="{Binding DeleteSelectedCommand}" Background="#A83232" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Vertical Resizer / Splitter 1 -->
            <GridSplitter Grid.Column="1" Width="4" Background="#141414" ResizeDirection="Columns" />

            <!-- Center: Viewport -->
            <Panel Grid.Column="2" Background="Transparent"
                   PointerPressed="Viewport_PointerPressed"
                   PointerMoved="Viewport_PointerMoved"
                   PointerReleased="Viewport_PointerReleased"
                   PointerWheelChanged="Viewport_PointerWheelChanged">
                <controls:SilkViewportControl x:Name="ViewportControl" DataContext="{Binding}" />
                <refguides:GuideLabelsOverlay x:Name="GuideLabelsOverlay" />
                <drafting:DraftingLabelsOverlay x:Name="DraftingLabelsOverlay" />
                <drafting:DraftingLegend DataContext="{Binding Drafting}"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" />
                <controls:SelectionBoxOverlay x:Name="SelectionBoxOverlay" />
                <controls:AxisTriadOverlay x:Name="AxisTriadOverlay" />

                <!-- Erro na cena: o modelo exibido é o último que executou com sucesso -->
                <Border IsVisible="{Binding ScriptEditor.HasErrors}"
                        Background="#E6B00020" BorderBrush="#FF5252" BorderThickness="1"
                        CornerRadius="4" Padding="10,6" Margin="10"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" MaxWidth="700">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Static res:Strings.SceneErrorTitle}" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ScriptEditor.ErrorSummary}" Foreground="White" TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{x:Static res:Strings.GoToError}" Command="{Binding ScriptEditor.GoToFirstErrorCommand}"
                                IsVisible="{Binding ScriptEditor.IsProjectOpen}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Boolean Edit Mode Banner -->
                <Border IsVisible="{Binding IsEditingBooleanGroup}" 
                        Background="#80D32F2F" BorderBrush="#D32F2F" BorderThickness="1" 
                        CornerRadius="4" Padding="10,5" Margin="10"
                        HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Editando Grupo Booleano:" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ActiveBooleanGroupName}" Foreground="White" VerticalAlignment="Center"/>
                        <Button Content="✕" Command="{Binding ExitBooleanEditModeCommand}" 
                                Background="Transparent" Foreground="White" BorderThickness="0" 
                                Padding="4,0" VerticalAlignment="Center" Cursor="Hand" />
                    </StackPanel>
                </Border>
            </Panel>

            <!-- Vertical Resizer / Splitter 2 -->
            <GridSplitter Grid.Column="3" Width="4" Background="#141414" ResizeDirection="Columns" />

            <!-- Right Sidebar: Model Tree (+ Properties) / Code (+ AI Chat) / I-O -->
            <Grid Grid.Column="4" Background="#1E1E1E">
                <TabControl Margin="0" Padding="0" SelectedIndex="{Binding SidebarTabIndex, Mode=TwoWay}">
                    <TabItem Header="{x:Static res:Strings.TreeTab}" Padding="10,5">
                        <!-- Model Entity Tree on top, Parametric Property Inspector below -->
                        <Grid RowDefinitions="*, 4, 1.2*">
                            <views:ModelTreeView Grid.Row="0" DataContext="{Binding ModelTree}" />
                            <GridSplitter Grid.Row="1" Height="4" Background="#141414" ResizeDirection="Rows" />
                            <views:PropertyInspectorView Grid.Row="2" DataContext="{Binding PropertyInspector}" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="{x:Static res:Strings.CodeTab}" Padding="10,5">
                        <!-- C# Code editor on top, AI Chat below -->
                        <Grid RowDefinitions="Auto,*,4,1.2*">
                            <!-- Barra do editor: botões (quebram linha quando o painel é estreito, Run primeiro),
                                 depois arquivos da cena e inserção de peças (só com uma cena aberta / peças declaradas) -->
                            <StackPanel Grid.Row="0" Margin="4" Spacing="4">
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="{x:Static res:Strings.RunCode}" Command="{Binding ScriptEditor.RunCodeCommand}"
                                            Background="#27AE60" Foreground="White" FontWeight="Bold" Width="40" HorizontalContentAlignment="Center"
                                            ToolTip.Tip="Run" Margin="0,0,4,4"/>
                                    <Button Content="{x:Static res:Strings.NewScene}" Command="{Binding ScriptEditor.NewSceneCommand}" FontSize="11" Padding="8,4" Margin="0,0,4,4"/>
                                    <Button Content="{x:Static res:Strings.OpenScene}" Command="{Binding ScriptEditor.OpenSceneCommand}" FontSize="11" Padding="8,4" Margin="0,0,4,4"/>
                                    <Button Content="{x:Static res:Strings.LoadLastScene}" Command="{Binding ScriptEditor.LoadLastSceneCommand}"
                                            IsVisible="{Binding ScriptEditor.ShowLoadLastSceneButton}" FontSize="11" Padding="8,4" Margin="0,0,4,4"/>
                                    <Button Content="{x:Static res:Strings.LoadCode}" Command="{Binding ScriptEditor.LoadCodeFromFileCommand}" FontSize="11" Padding="8,4" Margin="0,0,4,4"/>
                                    <Button Content="{x:Static res:Strings.SaveCode}" Command="{Binding ScriptEditor.SaveCodeToFileCommand}" FontSize="11" Padding="8,4" Margin="0,0,4,4"/>
                                    <Button Content="{x:Static res:Strings.UpdateCode}" Command="{Binding ScriptEditor.GenerateCodeCommand}" FontSize="11" Padding="8,4" Margin="0,0,4,4"/>
                                </WrapPanel>
                                <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding ScriptEditor.IsProjectOpen}">
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding ScriptEditor.ProjectFiles}"
                                              SelectedItem="{Binding ScriptEditor.ActiveFile, Mode=TwoWay}"
                                              ToolTip.Tip="{Binding ScriptEditor.ProjectName}"
                                              HorizontalAlignment="Stretch" MinWidth="120"/>
                                    <TextBox Grid.Column="1" Width="120" Margin="4,0,0,0"
                                             Text="{Binding ScriptEditor.NewFileName, Mode=TwoWay}"
                                             Watermark="{x:Static res:Strings.NewFileWatermark}"
                                             ToolTip.Tip="{x:Static res:Strings.NewFileTooltip}"/>
                                    <Button Grid.Column="2" Content="+" Command="{Binding ScriptEditor.CreateFileCommand}"
                                            ToolTip.Tip="{x:Static res:Strings.NewFileTooltip}" Margin="4,0,0,0"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ScriptEditor.HasPartTypes}">
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding ScriptEditor.PartTypes}"
                                              SelectedItem="{Binding ScriptEditor.SelectedPartType, Mode=TwoWay}"
                                              PlaceholderText="{x:Static res:Strings.PartTypePlaceholder}"
                                              HorizontalAlignment="Stretch" MinWidth="120"/>
                                    <Button Grid.Column="1" Content="{x:Static res:Strings.InsertPart}" Command="{Binding ScriptEditor.InsertPartCommand}"
                                            ToolTip.Tip="{x:Static res:Strings.InsertPartTooltip}" Margin="4,0,0,0"/>
                                </Grid>
                                <!-- Renomear (F2 no editor) -->
                                <Border IsVisible="{Binding ScriptEditor.IsRenaming}" Background="#252526"
                                        BorderBrush="#007ACC" BorderThickness="1" CornerRadius="3" Padding="6">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding ScriptEditor.RenameTitle}" Foreground="#CCCCCC" FontSize="11" TextWrapping="Wrap"/>
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding ScriptEditor.RenameText, Mode=TwoWay}"
                                                     controls:CodeEditorBehavior.FocusWhen="{Binding ScriptEditor.IsRenaming}">
                                                <TextBox.KeyBindings>
                                                    <KeyBinding Gesture="Enter" Command="{Binding ScriptEditor.ConfirmRenameCommand}"/>
                                                    <KeyBinding Gesture="Escape" Command="{Binding ScriptEditor.CancelRenameCommand}"/>
                                                </TextBox.KeyBindings>
                                            </TextBox>
                                            <Button Grid.Column="1" Content="OK" Command="{Binding ScriptEditor.ConfirmRenameCommand}" Margin="4,0,0,0"/>
                                            <Button Grid.Column="2" Content="✕" Command="{Binding ScriptEditor.CancelRenameCommand}" Margin="4,0,0,0"/>
                                        </Grid>
                                        <TextBlock Text="{Binding ScriptEditor.RenameError}" Foreground="#FF6B6B" FontSize="11" TextWrapping="Wrap"
                                                   IsVisible="{Binding ScriptEditor.RenameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Referências (Shift+F12 no editor): clicar abre o arquivo na linha -->
                                <Border IsVisible="{Binding ScriptEditor.HasReferences}" Background="#252526"
                                        BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="3" Padding="6">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding ScriptEditor.ReferencesTitle}" Foreground="#CCCCCC" FontSize="11"
                                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="✕" Command="{Binding ScriptEditor.CloseReferencesCommand}" Padding="6,0"/>
                                        </Grid>
                                        <ListBox ItemsSource="{Binding ScriptEditor.References}"
                                                 SelectedItem="{Binding ScriptEditor.SelectedReference, Mode=TwoWay}"
                                                 MaxHeight="160" FontSize="11" FontFamily="Consolas, Monospace"/>
                                    </StackPanel>
                                </Border>
                                <!-- Atalhos do editor: sempre visíveis para quem ainda não os conhece -->
                                <TextBlock Text="{x:Static res:Strings.EditorShortcutsHint}" Foreground="#808080" FontSize="10" TextWrapping="Wrap"/>
                            </StackPanel>
                            <AvaloniaEdit:TextEditor Grid.Row="1"
                                     Name="CodeEditor"
                                     SyntaxHighlighting="C#"
                                     controls:CodeEditorBehavior.DocumentText="{Binding ScriptEditor.GeneratedCSharpCode, Mode=TwoWay}"
                                     controls:CodeEditorBehavior.SelectedFeature="{Binding SelectedFeature}"
                                     controls:CodeEditorBehavior.PartSolidSpans="{Binding ScriptEditor.PartSolidSpans}"
                                     controls:CodeEditorBehavior.ErrorLines="{Binding ScriptEditor.ActiveFileErrorLines}"
                                     controls:CodeEditorBehavior.RevealLine="{Binding ScriptEditor.RevealLine}"
                                     controls:CodeEditorBehavior.CodeCommands="{Binding ScriptEditor}"
                                     controls:CodeEditorBehavior.HighlightSelectionOccurrences="True"
                                     FontFamily="Consolas, Fira Code, Monospace"
                                     Background="#1E1E1E"
                                     Foreground="#D4D4D4"
                                     ShowLineNumbers="True"
                                     BorderThickness="0"
                                     Margin="2"/>
                            <GridSplitter Grid.Row="2" Height="4" Background="#141414" ResizeDirection="Rows" />
                            <views:AiChatView Grid.Row="3" DataContext="{Binding AiChat}" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="{x:Static res:Strings.IOTab}" Padding="10,5">
                        <StackPanel Spacing="10" Margin="10">
                            <Button Content="{x:Static res:Strings.ImportStl}" Command="{Binding ImportStlCommand}" Background="#34495E" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                            <Button Content="{x:Static res:Strings.ExportStl}" Command="{Binding ExportStlCommand}" Background="#34495E" Foreground="White" ToolTip.Tip="{x:Static res:Strings.ExportStlTooltip}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                            <Button Content="{x:Static res:Strings.DeduceSolid}" Command="{Binding ReconstructMeshCommand}" Background="#8E44AD" Foreground="White" ToolTip.Tip="{x:Static res:Strings.DeduceSolidTooltip}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#007ACC" Padding="6,3">
            <Grid ColumnDefinitions="*, Auto, Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="White" VerticalAlignment="Center" FontSize="12" />
                
                <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Measurement}" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="12" />
                <Border Grid.Column="2" Background="White" CornerRadius="2" Padding="6,2" MinWidth="100">
                    <TextBlock Text="{Binding VcbText}" Foreground="Black" TextAlignment="Right" FontWeight="Bold" FontSize="12" />
                </Border>
            </Grid>
        </Border>
    </Grid>

</Window>
