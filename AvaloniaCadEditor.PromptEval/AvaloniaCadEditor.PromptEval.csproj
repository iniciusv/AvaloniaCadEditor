<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvaloniaCadEditor.Application\AvaloniaCadEditor.Application.csproj" />
    <ProjectReference Include="..\AvaloniaCadEditor.Harness\AvaloniaCadEditor.Harness.csproj" />
    <ProjectReference Include="..\AvaloniaCadEditor.Infrastructure\AvaloniaCadEditor.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Os casos têm arquivos .cs de cena: são dados, não código deste projeto. -->
  <ItemGroup>
    <Compile Remove="Cases\**" />
    <None Include="Cases\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
